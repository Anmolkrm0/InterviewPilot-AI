# Node Environment
NODE_ENV=production
PORT=3000

# AI Provider Configuration
# Options: 'mock' (default offline test/demo mode), 'gemini', 'groq', 'openai'
AI_PROVIDER=mock

# Hosted LLM API Key (Required if AI_PROVIDER is 'gemini', 'groq', or 'openai')
# Leave empty if using AI_PROVIDER=mock
AI_API_KEY=

# Optional Model Override
# For gemini: 'gemini-1.5-flash', 'gemini-2.0-flash', 'gemini-1.5-pro'
# For groq: 'llama-3.3-70b-versatile'
AI_MODEL=
